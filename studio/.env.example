DATABASE_URL="file:./prisma/dev.db"

NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32 (또는 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") 로 생성
NEXTAUTH_SECRET=""

# 구글: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 카카오: https://developers.kakao.com/console/app
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Toss Payments — 개발자센터(https://developers.tosspayments.com)에서 발급받은
# 상점 전용 키로 교체하기 전까지는 아래 공식 문서 데모 키로 결제창 테스트가 가능합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm"
TOSS_SECRET_KEY="test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6"

# --- Step 6: Admin 백오피스 & 운영 자동화 ---

# 콤마로 구분된 이메일 목록. 로그인/가입 시 role이 자동으로 "admin"으로 승격되어
# /admin 백오피스에 접근할 수 있습니다. (셀프서비스 승격 UI는 의도적으로 없음)
ADMIN_EMAILS=""

# 순수익률 계산에 사용하는 고정 환율 (KRW per 1 USD). 기본값 1380.
USD_TO_KRW_RATE="1380"

# IndexNow — 임의의 32자 hex 키. 비워두면 코드에서 안정적인 고정 키를 생성해 사용합니다.
# 주입 성공 시 워드프레스 루트에 {키}.txt 파일이 자동 생성되어, 그 루트가 실제 공개
# 도메인의 문서 루트라면 IndexNow 키 검증이 그대로 통과합니다.
INDEXNOW_KEY=""

# Google Indexing API — Search Console에 소유자로 등록된 서비스 계정 키가 있어야 합니다.
# 둘 중 하나만 설정하면 됩니다 (JSON 문자열 전체 또는 키 파일 경로).
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Step 7: 무료 SEO/GEO 진단 리포트 (Lead Magnet) ---

# 카카오 개발자센터(https://developers.kakao.com)에서 발급받은 JavaScript 키.
# 비어있으면 카카오톡 공유 버튼이 자동으로 "링크 복사"로 대체됩니다.
NEXT_PUBLIC_KAKAO_JS_KEY=""

# --- Step 8: 글로벌 확장 · i18n · 개발자 API · Stripe ---

# 다국어(KR|EN) 전환 시 next-intl이 저장하는 쿠키 이름 (변경 불필요, 참고용).
# NEXT_LOCALE 쿠키가 없으면 기본값 "ko" 로 렌더링됩니다.

# Stripe — https://dashboard.stripe.com/test/apikeys 에서 발급받은 "테스트 모드"
# Secret key를 입력하세요. Toss와 달리 Stripe는 계정별 키만 발급되어 공용 데모 키가
# 없으므로, 해외(USD) 결제 플로우를 실제로 테스트하려면 본인 계정 키가 필요합니다.
# 비어 있으면 /api/payments/stripe/* 가 503으로 응답하고 UI에 안내 메시지가 표시됩니다.
STRIPE_SECRET_KEY=""

# --- Step 10: Autonomous Agent · WP Plugin ---

# 주간 Self-Healing 크론 인증용 시크릿. `Authorization: Bearer <값>` 또는 관리자 세션.
# `npm run agent:cron` 실행 시 동일 값을 AGENT_CRON_SECRET으로 전달하세요.
AGENT_CRON_SECRET=""

# 플러그인 ZIP에 박히는 API 베이스 URL (미설정 시 NEXTAUTH_URL 사용).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
