MASTER_ADMIN_EMAIL="admin"
MASTER_ADMIN_PASSWORD="jooni1428"
MASTER_ADMIN_ID="admin-master-id"
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="jooni1428"

# 구글: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 카카오: https://developers.kakao.com/console/app
# - KAKAO_CLIENT_ID  = [내 애플리케이션] → [앱 키] → "REST API 키" (JavaScript 키 아님!)
# - KAKAO_CLIENT_SECRET = [카카오 로그인] → [보안] → "Client Secret" 코드 발급 후, 상태를 "사용함"으로 전환
# - 둘 중 하나라도 비어 있으면 로그인 페이지의 카카오 버튼이 자동으로 비활성화됩니다 (studio/lib/auth.ts).
# - [카카오 로그인] 활성화(ON) + [플랫폼] Web 사이트 도메인에 http://localhost:3000 등록 필요.
# - [Redirect URI]에 다음을 정확히 등록: {NEXTAUTH_URL}/api/auth/callback/kakao
#     로컬: http://localhost:3000/api/auth/callback/kakao
#     운영: https://실제도메인/api/auth/callback/kakao
#   (redirect_uri는 코드에 하드코딩되어 있지 않고 NextAuth가 NEXTAUTH_URL 기준으로 자동 생성합니다.)
# - client_id가 비어있거나 잘못되면 카카오가 KOE101(등록되지 않은 앱)로 응답합니다.
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

