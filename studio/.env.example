# --- Dynamic GEO narrative (audit result marketing sections) ---

# OpenAI — preferred. Uses gpt-4o-mini + JSON mode for industry-custom GEO copy.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional override (default: gpt-4o-mini)
# OPENAI_GEO_MODEL="gpt-4o-mini"
# POST /api/diagnose/sov-analysis — live SoV (default: gpt-4o-mini, Gemini fallback: gemini-1.5-flash)
# SOV_OPENAI_MODEL="gpt-4o-mini"
# SOV_GEMINI_MODEL="gemini-1.5-flash"

# Anthropic — used only when OPENAI_API_KEY is empty.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Optional override (default: claude-3-5-haiku-20241022)
# ANTHROPIC_GEO_MODEL="claude-3-5-haiku-20241022"
# Live-check / probe-live model (default: claude-haiku-4-5-20251001)
# Older accounts can still set claude-3-5-haiku-20241022 or claude-3-haiku-20240307
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Gemini — Google Search Grounding for Why & Status live-check
# https://aistudio.google.com/apikey
# Aliases also accepted: GOOGLE_GENERATIVE_AI_API_KEY / GOOGLE_API_KEY / GOOGLE_AI_API_KEY
GEMINI_API_KEY=""
# Live-check model (default: gemini-2.5-flash, fallback: gemini-2.5-flash-lite / gemini-2.0-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Perplexity — sonar realtime search for Why & Status live-check
# https://www.perplexity.ai/settings/api
# Alias also accepted: PPLX_API_KEY
PERPLEXITY_API_KEY=""

# Live-check (`/api/audit/live-check`) per-engine mock switches only.
# These do NOT affect AI Search Intelligence. ASI uses ASI_MODE + the four keys below.
MOCK_OPENAI=true
MOCK_GEMINI=true
MOCK_PERPLEXITY=true
MOCK_CLAUDE=false

# AI SEARCH INTELLIGENCE — Browser → /api/intelligence → Service → Adapter → vendor.
# Never NEXT_PUBLIC_* for these keys. Browser never calls OpenAI/Gemini/Perplexity/Anthropic.
# ASI_MODE=live    → real adapters (default when unset and any key exists)
# ASI_MODE=mock    → Mock Provider only (local UI without spend; never used for live tests)
# ASI_MODE=hybrid  → try live; missing key / HTTP failure → unavailable (no invented mock text)
# Server-only keys: OPENAI_API_KEY / GEMINI_API_KEY / PERPLEXITY_API_KEY / ANTHROPIC_API_KEY
# Empty values in the repo-root .env do not block non-empty studio/.env keys.
# Optional ASI model overrides (code defaults if unset):
# OPENAI_MODEL="gpt-4o-mini"
# PERPLEXITY_MODEL="sonar"
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
# GEMINI_MODEL and ANTHROPIC_MODEL above are reused by the ASI adapters.
# History persist (Visibility +17 across days). Off in mock unless ASI_PERSIST=1.
# Daily remesasure jobs also live here (schedule.json). Cron: npm run agent:cron
# ASI_PERSIST=1
# ASI_HISTORY_DIR=".data/asi"
ASI_MODE=live

# If both keys are empty, /api/generate-geo-report returns a deterministic heuristic
# narrative so the UI still renders industry-aware copy offline.

# --- Schema AI fact-check (semantic cross-check of visible page text vs JSON-LD) ---
# POST /api/seo/fact-check — reuses OPENAI_API_KEY (preferred) then GEMINI_API_KEY above.
# Optional model overrides:
# FACT_CHECK_OPENAI_MODEL="gpt-4o-mini"
# FACT_CHECK_GEMINI_MODEL="gemini-2.5-flash"
# 10-minute response cache is keyed by hash(url)+hash(schema); Firestore-backed when
# Firebase Admin is configured, in-memory only otherwise. /api/seo/fact-check falls
# back to a rule-based heuristic when no key is set or the LLM call fails.

# --- Admin "⚡ AI 데이터 최신화" (AI Hub / aiToolsData.json market-data refresh) ---
# POST /api/admin/ai-tools/refresh — tries Gemini (Google Search grounding), then OpenAI
# (Responses API `web_search` tool), then Perplexity `sonar`, in that order — whichever has
# a real, non-mocked key configured above. Falls back to a deterministic mock refresh when
# none are configured, so the admin button always works even with $0 spend.
# Optional model overrides:
# AI_TOOLS_REFRESH_GEMINI_MODEL="gemini-2.5-flash"
# AI_TOOLS_REFRESH_OPENAI_MODEL="gpt-4o-mini"

# Google PageSpeed Insights API v5 (required for live CWV / Lighthouse scores).
# https://developers.google.com/speed/docs/insights/v5/get-started
# Endpoint: https://www.googleapis.com/pagespeedonline/v5/runPagespeed
# Prefer setting this in studio/.env.local (Next.js loads it automatically).
# Hybrid crawl (/api/crawling/scan) resolves keys in this order:
#   PAGESPEED_API_KEY → VITE_GOOGLE_MAP_API_KEY → NEXT_PUBLIC_GOOGLE_PAGESPEED_API_KEY
PAGESPEED_API_KEY=""
VITE_GOOGLE_MAP_API_KEY=""
# NEXT_PUBLIC_GOOGLE_PAGESPEED_API_KEY=""
# GOOGLE_PAGESPEED_API_KEY=""
# GOOGLE_API_KEY=""
# NEXT_PUBLIC_PAGESPEED_API_KEY=""
# Missing key: /api/crawling/scan still calls PSI anonymously (rate-limit sensitive) and falls back to Cheerio TTFB.

# Google Custom Search (Programmable Search) — 타겟 발굴 2순위 (네이버 고갈 시)
# https://developers.google.com/custom-search/v1/overview
# https://programmablesearchengine.google.com/
# Used by POST /api/crawling/target-finder → www.googleapis.com/customsearch/v1
# API key fallback: GOOGLE_SEARCH_API_KEY → VITE_GOOGLE_MAP_API_KEY
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# YouTube Data API v3 — Insights "AI 유튜브 영상 인사이트"
# https://developers.google.com/youtube/v3/getting-started
# Used by /api/insights/youtube-search
# Fallback: GOOGLE_YOUTUBE_API_KEY → GOOGLE_API_KEY → GOOGLE_SEARCH_API_KEY
YOUTUBE_API_KEY=""

# Google Places API (legacy Text Search + Place Details) — 장소 기반 타깃 수집
# https://developers.google.com/maps/documentation/places/web-service/search-text
# POST /api/crawling/places  { location, keyword, neededCount }
# target-finder 2순위 보강 (네이버 고갈 시) 및 engine=places
# Key fallback: GOOGLE_PLACES_API_KEY → GOOGLE_MAPS_API_KEY → VITE_GOOGLE_MAP_API_KEY
# GCP에서 Places API 를 활성화하세요.
GOOGLE_PLACES_API_KEY=""

# Google Sheets + Drive — 수집 목록 '구글 시트로 내보내기'
# https://console.cloud.google.com/apis/library/sheets.googleapis.com
# https://console.cloud.google.com/apis/library/drive.googleapis.com
# API keys (enable Sheets/Drive APIs on the same GCP project):
GOOGLE_SHEETS_API=""
GOOGLE_DRIVE_API=""
# Service account JSON is REQUIRED to create/write spreadsheets (API keys alone are read-only).
# Prefer one of:
#   GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#   FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./xxx-firebase-adminsdk.json
#   GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Enable Sheets API + Drive API for that service account's project.
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=""
# GOOGLE_SHEETS_SERVICE_ACCOUNT_PATH=""

# Naver Open API — 웹검색(타겟 사이트 자동 발굴 1순위, display=100)
# https://developers.naver.com/apps/#/list
# /api/crawling/target-finder → openapi.naver.com/v1/search/webkr.json
# /api/admin/geo-insights → openapi.naver.com/v1/search/news.json (키워드 카테고리 풀)
# Google CSE는 네이버 결과가 목표치 미달일 때 2순위로 보강합니다.
