// REDUE AI SEO & GEO Studio — Auth / Credits / Payments database.
// SQLite is used so the whole platform runs locally without any external
// service account (see plan Step 5, "Decisions locked in").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth.js core models (see https://authjs.dev/reference/adapter/prisma) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- REDUE domain models ---

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("user") // "user" | "admin" — see lib/auth.ts ADMIN_EMAILS bootstrap
  planId           String    @default("starter")
  creditsRemaining Int       @default(1)
  freeAuditsUsed     Int       @default(0)
  dailyAuditCount    Int       @default(0)
  lastAuditResetDate String?
  planRenewsAt       DateTime?
  createdAt        DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  injectionHistory   InjectionHistory[]
  apiUsageLogs       ApiUsageLog[]
  apiKeys            ApiKey[]
  auditReports       AuditReport[]
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  amount          Int
  currency        String   @default("KRW")
  method          String
  provider        String   @default("toss") // "toss" | "stripe"
  status          String
  tossPaymentKey  String?
  tossOrderId     String?
  stripeSessionId String? // Stripe Checkout Session id, used by /api/payments/stripe/confirm
  receiptUrl      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InjectionHistory {
  id              String   @id @default(cuid())
  userId          String
  targetDomain    String
  siteUrl         String? // optional public URL, used for IndexNow/Google Indexing pings
  cmsType         String
  durationMs      Int?
  patchedAt       DateTime @default(now())
  score           Int
  maxScore        Int
  statusLabel     String
  diagnosticsJson String
  backupZipPath   String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiUsageLogs ApiUsageLog[]
  indexingLogs IndexingLog[]
}

model ApiUsageLog {
  id                 String   @id @default(cuid())
  userId             String
  injectionHistoryId String
  model              String // "gpt-4o-mini" | "claude-3.5-haiku"
  inputTokens        Int
  outputTokens       Int
  costUsd            Float
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  injectionHistory InjectionHistory @relation(fields: [injectionHistoryId], references: [id], onDelete: Cascade)
}

model AuditLead {
  id          String   @id @default(cuid())
  url         String
  score       Int
  maxScore    Int
  statusLabel String
  reportJson  String
  userId      String? // set when the visitor was already signed in
  projectId   String? // optional link to admin Project workspace
  createdAt   DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

/// Signed-in (admin) diagnosis history — survives browser close / new devices.
model AuditReport {
  id          String   @id @default(cuid())
  domain      String
  brandName   String
  category    String   @default("")
  score       Int
  grade       String   @default("")
  statusLabel String
  reportJson  String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId, createdAt])
  @@map("audit_reports")
}

/// Admin project workspace (ported from redue-seo-inspector-ai projects table).
model Project {
  id                String   @id @default(cuid())
  name              String
  targetUrl         String
  cmsType           String   @default("UNKNOWN")
  category          String   @default("SOLUTIONS") // MEDICAL | CORPORATE | COMMERCE | PUBLIC | SOLUTIONS
  status            String   @default("ACTIVE") // ACTIVE | ARCHIVED
  thumbnailUrl      String?
  latestScore       Int?
  latestSeoScore    Int?
  latestGeoScore    Int?
  latestSchemaScore Int?
  latestAuditId     String?
  auditCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  auditLeads AuditLead[]
}

/// Admin crawling collected sites (해외 확장 대비: country / region / industry / targetTag).
model CrawledSite {
  id          String   @id @default(cuid())
  url         String
  siteName    String
  /// KR | US | JP | GLOBAL
  country     String   @default("KR")
  /// e.g. "부산", "부산 해운대구", "California"
  region      String?
  /// MEDICAL_CLINIC | LODGING_TRAVEL | PROFESSIONAL_LEGAL | MANUFACTURING_B2B | COMMERCE | EDUCATION_WEDDING | OTHER
  category    String   @default("OTHER")
  /// NEW_PROSPECT | EXISTING_CLIENT | COMPETITOR
  targetTag   String?
  /// PENDING | ANALYZING | DONE | FAILED
  status      String   @default("PENDING")
  /// success | warning | failed — 수집 품질 배지용 (optional)
  collectStatus String?
  menuPath    String?
  title       String?
  snippet     String?
  errorMessage String?
  crawledAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country, region])
  @@index([category])
  @@index([targetTag])
  @@index([status])
  @@index([crawledAt])
}

/// Unique-by-root-domain lead store. searchKeywords is a JSON string array
/// (SQLite has no native scalar lists / enums).
/// status: PENDING | DIAGNOSED | CONTACTED | EXCLUDED
model TargetSite {
  id             String   @id @default(cuid())
  /// Normalized root domain (eTLD+1), e.g. "example.co.jp"
  domain         String   @unique
  originalUrl    String
  status         String   @default("PENDING")
  /// JSON string[] of search keywords that surfaced this domain
  searchKeywords String   @default("[]")
  /// Representative email extracted from homepage / contact pages
  email          String?
  /// Contact-form page URL when no email was found
  contactFormUrl String?
  /// Representative phone (tel: href / footer)
  phoneNumber    String?
  /// Canonical business address (homepage / footer / contact / JSON-LD)
  address        String?
  /// KakaoTalk channel or open-chat URL (pf.kakao.com / open.kakao.com)
  kakaoChannelUrl String?
  /// Instagram profile URL
  instagramUrl   String?
  /// Naver TalkTalk URL (talk.naver.com)
  naverTalkUrl   String?
  /// Google rating (Places / later enrichment)
  googleRating   Float?
  /// Google review count
  googleReviewCount Int?
  /// Last successful HTML fetch + email/form parse
  lastScrapedAt  DateTime?
  /// Company address snippet extracted from homepage / footer / contact / about
  parsedAddress  String?
  /// True when address could not be parsed — keep the lead, flag for admin review
  checkLocationNeeded Boolean @default(false)
  /// Precision SEO/GEO diagnosis JSON (AuditReport)
  diagnosisReport String?
  diagnosedAt     DateTime?
  /// Firestore audit_projects / Prisma AuditLead id for /audit/result?id=
  auditLeadId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSearchedAt DateTime @default(now())

  @@index([status])
  @@index([lastSearchedAt])
  @@index([lastScrapedAt])
  @@index([phoneNumber])
  @@map("target_sites")
}

// External developer PaaS API (Step 8) — a user can mint one or more secret
// keys ("redue_live_sk_...") to call POST /api/v1/schema/generate. Only a
// bcrypt hash of the secret is stored; `keyPrefix` is the truncated,
// non-secret display value shown in the /developer dashboard after creation.
model ApiKey {
  id             String    @id @default(cuid())
  userId         String
  label          String
  keyPrefix      String // e.g. "redue_live_sk_ab12cd34" (first 24 chars, safe to display)
  keyHash        String // bcrypt hash of the full secret key
  dailyLimit     Int
  monthlyLimit   Int
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  callLogs ApiCallLog[]
}

model ApiCallLog {
  id           String   @id @default(cuid())
  apiKeyId     String
  endpoint     String
  domain       String
  success      Boolean
  statusCode   Int
  creditsUsed  Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
}

model IndexingLog {
  id                 String   @id @default(cuid())
  injectionHistoryId String
  service            String // "indexnow" | "google"
  targetUrl          String
  success            Boolean
  message            String?
  createdAt          DateTime @default(now())

  injectionHistory InjectionHistory @relation(fields: [injectionHistoryId], references: [id], onDelete: Cascade)
}
