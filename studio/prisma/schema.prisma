// REDUE AI SEO & GEO Studio — Auth / Credits / Payments database.
// SQLite is used so the whole platform runs locally without any external
// service account (see plan Step 5, "Decisions locked in").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth.js core models (see https://authjs.dev/reference/adapter/prisma) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- REDUE domain models ---

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("user") // "user" | "admin" — see lib/auth.ts ADMIN_EMAILS bootstrap
  planId           String    @default("starter")
  creditsRemaining Int       @default(1)
  planRenewsAt     DateTime?
  createdAt        DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  injectionHistory   InjectionHistory[]
  apiUsageLogs       ApiUsageLog[]
  apiKeys            ApiKey[]
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  amount          Int
  currency        String   @default("KRW")
  method          String
  provider        String   @default("toss") // "toss" | "stripe"
  status          String
  tossPaymentKey  String?
  tossOrderId     String?
  stripeSessionId String? // Stripe Checkout Session id, used by /api/payments/stripe/confirm
  receiptUrl      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InjectionHistory {
  id              String   @id @default(cuid())
  userId          String
  targetDomain    String
  siteUrl         String? // optional public URL, used for IndexNow/Google Indexing pings
  cmsType         String
  durationMs      Int?
  patchedAt       DateTime @default(now())
  score           Int
  maxScore        Int
  statusLabel     String
  diagnosticsJson String
  backupZipPath   String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiUsageLogs ApiUsageLog[]
  indexingLogs IndexingLog[]
}

model ApiUsageLog {
  id                 String   @id @default(cuid())
  userId             String
  injectionHistoryId String
  model              String // "gpt-4o-mini" | "claude-3.5-haiku"
  inputTokens        Int
  outputTokens       Int
  costUsd            Float
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  injectionHistory InjectionHistory @relation(fields: [injectionHistoryId], references: [id], onDelete: Cascade)
}

model AuditLead {
  id          String   @id @default(cuid())
  url         String
  score       Int
  maxScore    Int
  statusLabel String
  reportJson  String
  userId      String? // set when the visitor was already signed in
  createdAt   DateTime @default(now())
}

// External developer PaaS API (Step 8) — a user can mint one or more secret
// keys ("redue_live_sk_...") to call POST /api/v1/schema/generate. Only a
// bcrypt hash of the secret is stored; `keyPrefix` is the truncated,
// non-secret display value shown in the /developer dashboard after creation.
model ApiKey {
  id             String    @id @default(cuid())
  userId         String
  label          String
  keyPrefix      String // e.g. "redue_live_sk_ab12cd34" (first 24 chars, safe to display)
  keyHash        String // bcrypt hash of the full secret key
  dailyLimit     Int
  monthlyLimit   Int
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  callLogs ApiCallLog[]
}

model ApiCallLog {
  id           String   @id @default(cuid())
  apiKeyId     String
  endpoint     String
  domain       String
  success      Boolean
  statusCode   Int
  creditsUsed  Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
}

model IndexingLog {
  id                 String   @id @default(cuid())
  injectionHistoryId String
  service            String // "indexnow" | "google"
  targetUrl          String
  success            Boolean
  message            String?
  createdAt          DateTime @default(now())

  injectionHistory InjectionHistory @relation(fields: [injectionHistoryId], references: [id], onDelete: Cascade)
}
